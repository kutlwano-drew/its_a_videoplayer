<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Its A Video Player" Language="1033" Version="$(var.AppVersion).0" Manufacturer="Developer" UpgradeCode="a6b8c4d2-3111-4bb2-a602-5e43a91bf2f2">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />
    <MediaTemplate EmbedCab="yes" />
    
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Its A Video Player" />
      </Directory>
    </Directory>
    
    <Feature Id="ProductFeature" Title="Main Application" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Product>
</Wix>